{
  "title": "SOC - Kubernetes Runtime Security",
  "uid": "soc-falco",
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": [
    "security",
    "falco",
    "soc"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Alerts (last 1h)",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({source=\"syscall\"} [1h]))",
          "legendFormat": "total",
          "queryType": "instant"
        }
      ]
    },
    {
      "id": 2,
      "title": "Critical/Error (last 1h)",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({source=\"syscall\", priority=~\"Critical|Error|Emergency|Alert\"} [1h]))",
          "legendFormat": "critical",
          "queryType": "instant"
        }
      ]
    },
    {
      "id": 3,
      "title": "Alerts by priority",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (priority) (count_over_time({source=\"syscall\"} [5m]))",
          "legendFormat": "{{priority}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Top triggered rules",
      "type": "barchart",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "topk(10, sum by (rule) (count_over_time({source=\"syscall\"} [$__range])))",
          "legendFormat": "{{rule}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Live security events",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{source=\"syscall\"}"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    }
  ]
}
